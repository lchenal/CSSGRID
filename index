<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
    body, html {
      padding: 0;
      margin: 0;
      width: 100vw;
      min-height: 100vh;
    }
    @media (min-width: 640px) {
      body {
        display: grid;
        grid-template-columns: minmax(120px, 200px) 1fr minmax(120px, 200px); /* définit le comportement de chaque colonne*/
        grid-template-rows: auto 1fr auto;
        gap: 5px;
        padding: 5px;
        background: #999;
        box-sizing: border-box;
      }
      header {
        grid-row: 1;
        grid-column: 1 / 4;
        min-height: 60px;
      }
      nav {
        grid-row: 2;
        grid-column: 1 / 2;
      }
      article {
        grid-row: 2;
        grid-column: 2 / 3;
      }
      aside {
        grid-row: 2;
        grid-column: 3 / 4;
      }
      footer {
        grid-row: 3;
        grid-column: 1 / 4;
        min-height: 60px;
      }
    }
    @media (max-width: 640px) { /*design sur une colonne*/
      body {
        display: grid;
        grid-template-rows:
          minmax(50px, auto) /*header */
          minmax(50px, auto) /*nav */
          minmax(100px, 1fr) /*article */
          minmax(50px, auto) /*aside */
          minmax(50px, auto); /*footer */

        gap: 5px;
        padding: 5px;
        background: #999;
        box-sizing: border-box;
      }
    }
    header  { background: #feb; }
    article { background: #dd8; }
    nav     { background: #ccf; }
    aside   { background: #ccf; }
    footer  { background: #feb; }
 header, article, nav, aside, footer {
      border-radius: 5px;
      padding: 5px;
    }
    </style>
</head>
<body>
    <header>Header</header>
    <nav>Navigation</nav>
    <article>Article</article>
    <aside>Aside</aside>
    <footer>Footer</footer>
</body>
</html>
